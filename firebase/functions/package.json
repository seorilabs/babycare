{
  "name": "@babycare/firebase-functions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/src/index.js",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm run build && node --test --test-concurrency=1 lib/tests/invite-service.test.js lib/tests/account-deletion-service.test.js lib/tests/callable-boundary.test.js lib/tests/analytics-service.test.js",
    "test:emulator": "node --test --test-concurrency=1 lib/tests/firestore-invite-repository.emulator.test.js lib/tests/firestore-account-deletion-repository.emulator.test.js"
  },
  "dependencies": {
    "firebase-admin": "13.10.0",
    "firebase-functions": "7.2.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
